# Template only — copy values into `.env.development` / `.env.production`
# Next.js loads those files by NODE_ENV (no `.env.local` switching).

# --- development (Local Supabase @ 127.0.0.1) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_from_supabase_status

# --- production (Cloud Supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_cloud_anon_or_publishable_key

# Server-only — required for admin bulk writes (e.g. bulkUpsertVendorMapping
# bypasses RLS) and for invoking the process-receipt-ocr Edge Function
# Local: copy "service_role key" from `supabase status`
# Never expose this key to the browser / NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# NOTE: GEMINI_API_KEY / GEMINI_MODEL are set on the Supabase Edge Function
# (process-receipt-ocr), NOT here — see supabase/.env.local(.example) and
# supabase/functions/process-receipt-ocr/index.ts. Next.js never calls Gemini.
